# Copy to .env (git-ignored) and fill in. Never commit real values.

# Secret key for HMAC pseudonymisation (patient tokens, UID remapping, date shifts).
# Changing it breaks linkage with everything already de-identified.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
DEID_SECRET=

# Local DB. Default is SQLite; for PostgreSQL:
#   postgresql+psycopg://deid:deid@localhost:5432/deid
DATABASE_URL=sqlite:///data/db/deid.sqlite

# Only needed for scripts/deidentify_with_comprehend_medical.py
AWS_REGION=us-east-1
