{
  "cases": [
    {
      "id": "CU01",
      "name": "uae_passport_expired_and_bad_mrz",
      "region": "UAE",
      "description": "UAE passport that expired 45 days ago and whose MRZ document-number check digit is wrong.",
      "expected_result": "fail",
      "expected_findings": ["document_expired", "mrz_check_digit_document_number"],
      "person": {"region": "UAE", "given": "Omar", "surname": "Al Hammadi",
                 "given_native": "عمر", "surname_native": "الحمادي", "sex": "M", "dob": "1988-03-14"},
      "documents": [
        {"type": "passport", "photo": true, "mutations": [
          {"op": "expire", "days_ago": 45},
          {"op": "break_check_digit", "target": "mrz_document_number"}
        ]}
      ]
    },
    {
      "id": "CU02",
      "name": "emirates_id_holder_aged_16",
      "region": "UAE",
      "description": "Internally consistent Emirates ID (number, MRZ and printed DOB agree) for a 16-year-old. Fails only an age rule.",
      "expected_result": "fail",
      "expected_findings": ["holder_under_minimum_age"],
      "person": {"region": "UAE", "given": "Hamdan", "surname": "Al Shamsi",
                 "given_native": "حمدان", "surname_native": "الشامسي", "sex": "M", "age": 16},
      "documents": [{"type": "emirates_id"}]
    },
    {
      "id": "CU03",
      "name": "eid_and_passport_dob_disagree",
      "region": "UAE",
      "description": "Emirates ID and passport for the same person. The passport DOB was changed everywhere (printed and MRZ), so each document is valid on its own but they disagree.",
      "expected_result": "fail",
      "expected_findings": ["dob_mismatch_across_documents"],
      "person": {"region": "UAE", "given": "Fatima", "surname": "Al Suwaidi",
                 "given_native": "فاطمة", "surname_native": "السويدي", "sex": "F", "dob": "1991-07-02"},
      "documents": [
        {"type": "emirates_id", "file": "emirates_id.pdf"},
        {"type": "passport", "file": "passport.pdf", "mutations": [
          {"op": "set_dob", "date": "1986-07-02", "printed": true, "mrz": true}
        ]}
      ]
    },
    {
      "id": "CU04",
      "name": "emirates_id_dob_overlay",
      "region": "UAE",
      "description": "Emirates ID PDF whose printed DOB was covered with a white patch and retyped; the MRZ on the back keeps the real DOB. Includes a phone photo.",
      "expected_result": "fail",
      "expected_findings": ["visual_tamper_font_mismatch", "pdf_incremental_edit", "pdf_producer_image_editor", "dob_mismatch_visual_vs_mrz",
                            "emirates_id_birth_year_mismatch"],
      "person": {"region": "UAE", "given": "Khalid", "surname": "Al Nuaimi",
                 "given_native": "خالد", "surname_native": "النعيمي", "sex": "M", "dob": "2002-11-20"},
      "documents": [
        {"type": "emirates_id", "photo": true, "mutations": [
          {"op": "overlay", "field": "dob", "value": "20/11/1996"}
        ]}
      ]
    },
    {
      "id": "CU05",
      "name": "aed_statement_salary_overlay_and_inflated_balance",
      "region": "UAE",
      "description": "AED statement (bucket 4, £500K-£1M) with the salary credit patched x8 and the closing balance inflated x2.5. MT940/CAMT.053/OFX keep the genuine figures.",
      "expected_result": "fail",
      "expected_findings": ["visual_tamper_font_mismatch", "pdf_incremental_edit", "running_balance_arithmetic",
                            "closing_balance_not_supported_by_transactions", "pdf_vs_structured_mismatch"],
      "person": {"region": "UAE", "given": "Mariam", "surname": "Al Hashimi",
                 "given_native": "مريم", "surname_native": "الهاشمي", "sex": "F"},
      "documents": [
        {"type": "bank_statement", "bank": "UAE", "bucket": 4, "file": "statement.pdf", "mutations": [
          {"op": "overlay", "txn": "salary", "factor": 8},
          {"op": "inflate_closing", "factor": 2.5, "structured_files": "genuine"}
        ]}
      ]
    },
    {
      "id": "CU06",
      "name": "uae_funds_parking_before_cutoff",
      "region": "UAE",
      "description": "AED 3,000,000 cash deposit one day before the statement ends, lifting the balance two buckets.",
      "expected_result": "review",
      "expected_findings": ["large_round_cash_deposit_near_period_end", "balance_bucket_inflated_by_single_credit"],
      "person": {"region": "UAE", "given": "Ahmed", "surname": "Al Mansoori",
                 "given_native": "أحمد", "surname_native": "المنصوري", "sex": "M"},
      "documents": [
        {"type": "emirates_id"},
        {"type": "bank_statement", "bank": "UAE", "bucket": 2, "mutations": [
          {"op": "add_transaction", "days_before_end": 1, "description": "CASH DEPOSIT BRANCH 014", "amount": 3000000}
        ]}
      ]
    },
    {
      "id": "CU07",
      "name": "uae_passport_vs_statement_spelling",
      "region": "UAE",
      "description": "Passport says MOHAMED (MRZ too), bank statement says Mohammed. Same person: a fuzzy name match must accept it.",
      "expected_result": "pass",
      "expected_findings": ["name_transliteration_variant"],
      "person": {"region": "UAE", "given": "Mohammed", "surname": "Al Falasi",
                 "given_native": "محمد", "surname_native": "الفلاسي", "sex": "M"},
      "documents": [
        {"type": "passport", "mutations": [{"op": "set_name", "given": "Mohamed", "mrz": true}]},
        {"type": "bank_statement", "bank": "UAE", "bucket": 3}
      ]
    },
    {
      "id": "CU08",
      "name": "jebel_ali_shipment_diverted_and_late",
      "region": "UAE",
      "description": "UAE->Pakistan shipment: invoice asks for payment to an account that is not on the seller's statement, and the B/L was shipped 9 days after the L/C latest shipment date.",
      "expected_result": "fail",
      "expected_findings": ["invoice_beneficiary_account_differs_from_seller_statement", "shipment_after_lc_latest_date"],
      "documents": [
        {"type": "trade", "scenario": "UAE_to_PK", "seller_statement": true, "mutations": [
          {"op": "divert_payment"},
          {"op": "late_shipment", "days": 9}
        ]}
      ]
    },
    {
      "id": "CU09",
      "name": "india_aadhaar_and_pan_defects",
      "region": "IN",
      "description": "Aadhaar failing Verhoeff plus a PAN whose holder-type character is C (company) on a personal card.",
      "expected_result": "fail",
      "expected_findings": ["aadhaar_verhoeff_check", "pan_holder_type_not_individual"],
      "person": {"region": "IN", "given": "Rohan", "surname": "Mehta",
                 "given_native": "रोहन", "surname_native": "मेहता", "sex": "M", "dob": "1990-01-05"},
      "documents": [
        {"type": "aadhaar", "mutations": [{"op": "break_check_digit", "target": "id_number"}]},
        {"type": "pan_card", "mutations": [{"op": "break_check_digit", "target": "id_number"}]}
      ]
    },
    {
      "id": "CU10",
      "name": "uk_statement_holder_differs_from_licence",
      "region": "UK",
      "description": "UK driving licence for one person submitted with a bank statement in someone else's name.",
      "expected_result": "fail",
      "expected_findings": ["holder_name_mismatch_with_id"],
      "people": {
        "applicant": {"region": "UK", "given": "Sarah", "surname": "Whitfield", "sex": "F", "dob": "1985-05-04"},
        "other": {"region": "UK", "given": "Daniel", "surname": "Okafor", "sex": "M"}
      },
      "documents": [
        {"type": "uk_driving_licence", "holder": "applicant"},
        {"type": "bank_statement", "bank": "UK", "bucket": 5, "holder": "other"}
      ]
    }
  ]
}
